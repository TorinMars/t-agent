PORT=3000
T_AGENT_MODE=client
SESSION_SECRET=your-random-secret-change-this

# The Client is a single-user application; this ID is used for internal data ownership, and login uses an authenticator.
SINGLE_USER_ID=local
# Listens on this machine only by default. Change to 0.0.0.0 and restart the Client to allow access from a phone on the same LAN.
# The authenticator must be bound for the first time by scanning the QR code at a local localhost address; no initial password is needed.
# When exposing it externally, use an HTTPS reverse proxy and a firewall to limit who can reach it.
HOST=127.0.0.1
# Set to true explicitly when a trusted intranet needs plain-HTTP login; it does not restrict requests to intranet IPs.
CLIENT_ALLOW_HTTP=false
# When the service runs as root on Linux, the web terminal drops privileges to this user (default dev, created automatically by install.sh); leave empty to not drop privileges.
# Claude Code does not allow the "skip permission prompts" mode as root. This has no effect when the service already runs as an ordinary user, or on macOS.
TERMINAL_USER=
# The only login entrance visible when logged out; every other address returns 404. Starts with /, at least 6 characters, may have several levels; leave empty to use /torin/hide/login.
CLIENT_LOGIN_PATH=
# Comma-separated origins allowed to embed this Client's pages. Cross-site requires HTTPS.
CLIENT_FRAME_ORIGINS=
# Set a different cookie name for each Client sharing a hostname on different ports.
CLIENT_SESSION_COOKIE_NAME=connect.sid

# Root directory in which md files are created automatically for new tasks (defaults to ~/tasks when empty)
TASKS_BASE_DIR=/path/to/your/tasks

# Engine component. The Client mode already includes the Engine; a standalone node uses T_AGENT_MODE=engine.
ENGINE_NAME=my-engine
ENGINE_OWNER_ID=local
# A standalone Engine always listens on 0.0.0.0; who can reach it is controlled by the firewall, tokens and the reverse proxy.
# Optional: set a persistent directory or SQLite file for a standalone Engine.
# T_AGENT_DATA_DIR=/var/lib/t-agent-engine
# T_AGENT_DB_PATH=/var/lib/t-agent-engine/engine.sqlite

# Client update check: Git installs use fetch/show, old archive installs use the GitHub version endpoint.
GITHUB_VERSION_URL=https://api.github.com/repos/TorinMars/t-agent/contents/VERSION.json?ref=main
UPDATE_GITHUB_REPOSITORY=TorinMars/t-agent
UPDATE_GITHUB_REF=main
UPDATE_GIT_REMOTE=origin
UPDATE_GIT_BRANCH=main
UPDATE_CHECK_ENABLED=true
UPDATE_CHECK_INTERVAL_SECONDS=1800
UPDATE_CHECK_STARTUP_DELAY_SECONDS=30

# Optional for private repositories, read by the server only; a Token sent from the frontend must never be used.
# GITHUB_TOKEN=

# The Codex chat runs the `codex` CLI. It is looked for on PATH, in the usual install folders of the user (~/.local/bin, ~/.bun/bin,
# ~/.npm-global/bin, the newest ~/.nvm node ...) and through the login shell of the user. When the service cannot find it, give its full path.
# CODEX_PATH=/full/path/to/codex
# The same for the claude command that is started from a terminal (the Environment tab checks it).
# CLAUDE_PATH=/full/path/to/claude

# In the clean-up list of code directories, repos untouched for more than this many days are marked as suggested for cleanup first; default 30
# TASK_IDLE_DAYS=30
