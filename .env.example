PORT=3000
T_AGENT_MODE=client
SESSION_SECRET=your-random-secret-change-this

# 用户账号，格式: username:salt:hash
# 用 node scripts/gen-password.js <username> <password> 生成
AUTH_USERS=alice:salt1:hash1

# 新建任务时自动创建 md 文件的根目录（不填则默认 ~/tasks）
TASKS_BASE_DIR=/path/to/your/tasks

# Engine 组件。Client 模式已内置 Engine；独立节点使用 T_AGENT_MODE=engine。
ENGINE_NAME=my-engine
ENGINE_OWNER_ID=alice
ENGINE_WORKSPACE_ROOTS=/path/to/your/tasks
# 独立 Engine 默认只监听 127.0.0.1；通过反向代理或内网提供访问时可设为 0.0.0.0。
ENGINE_HOST=127.0.0.1
# 可选：为独立 Engine 指定持久化目录或 SQLite 文件。
# T_AGENT_DATA_DIR=/var/lib/t-agent-engine
# T_AGENT_DB_PATH=/var/lib/t-agent-engine/engine.sqlite

# 检查更新：公开仓库使用 GitHub Raw VERSION.json 链接。
# 留空时会尝试从 origin 和 UPDATE_GIT_BRANCH 自动推导。
GITHUB_VERSION_URL=https://raw.githubusercontent.com/owner/repository/main/VERSION.json
UPDATE_GIT_REMOTE=origin
UPDATE_GIT_BRANCH=main
UPDATE_CHECK_ENABLED=true
UPDATE_CHECK_INTERVAL_SECONDS=1800
UPDATE_CHECK_STARTUP_DELAY_SECONDS=30

# 允许执行“立即更新”的本地用户名，逗号分隔；默认 AUTH_USERS 中第一个账号。
UPDATE_ADMIN_USERS=alice

# 私有仓库可选，仅由服务端读取，禁止使用前端传入的 Token。
# GITHUB_TOKEN=
