T_AGENT_CLIENT_IMAGE=ghcr.io/torinmars/t-agent-client:latest
# Set 0.0.0.0 to allow remote connections. HTTPS login is required unless HTTP is explicitly enabled.
T_AGENT_CLIENT_BIND=127.0.0.1
T_AGENT_CLIENT_PORT=3000
# Keep separate from Engine and native Client data. Includes the encryption key.
T_AGENT_CLIENT_STORAGE_DIR=${HOME}/.torin/t-agent-client
TZ=Asia/Shanghai

# Empty inherits <storage directory>/tasks. This is a host path mounted at /workspace.
T_AGENT_CLIENT_WORKSPACE_DIR=

# Only for trusted intranets. HTTP sends authentication and sessions unencrypted.
T_AGENT_CLIENT_ALLOW_HTTP=false
