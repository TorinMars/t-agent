# GitHub Actions 发布的 Engine 镜像。也可以改为自己的镜像地址或固定版本标签。
T_AGENT_ENGINE_IMAGE=ghcr.io/torinmars/t-agent-engine:latest

# 默认仅允许本机/Nginx 访问；需要直接暴露时改成 0.0.0.0。
T_AGENT_ENGINE_BIND=127.0.0.1
T_AGENT_ENGINE_PORT=3100
T_AGENT_ENGINE_NAME=docker-engine
T_AGENT_ENGINE_OWNER_ID=engine

# 数据库和任务文件在宿主机上的持久化目录。
T_AGENT_ENGINE_DATA_DIR=./docker-data
T_AGENT_ENGINE_WORKSPACE_DIR=./tasks

# 工作目录在容器中的绝对路径。迁移旧 Engine 时可与宿主机路径保持一致。
T_AGENT_ENGINE_WORKSPACE_CONTAINER=/workspace

T_AGENT_UPDATE_CHECK_INTERVAL_SECONDS=1800
TZ=Asia/Shanghai

