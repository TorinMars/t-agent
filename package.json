{
  "name": "torin-x-web",
  "version": "2.84.47",
  "description": "T-Agent task client with browser terminals",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:client": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test --test-concurrency=2",
    "test:quick": "node scripts/test-quick.js",
    "release": "node scripts/release.js",
    "vendor": "node scripts/fetch-vendor.js",
    "build:markdown": "esbuild scripts/markdown-view-entry.js --bundle --minify --format=iife --global-name=MarkdownView --outfile=public/js/markdown-view.js",
    "build:monaco": "node scripts/build-monaco.js",
    "build:h5-shell": "esbuild scripts/h5-shell/entry.jsx --bundle --minify --format=iife --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outfile=public/js/h5-shell.js",
    "build:agent-chat": "esbuild scripts/agent-chat/entry.jsx --bundle --minify --format=iife --global-name=AgentChatUI --define:process.env.NODE_ENV=\\\"production\\\" --outfile=public/js/agent-chat-ui.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/headless": "5.5.0",
    "ali-oss": "^6.23.0",
    "axios": "^1.7.2",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.8.2",
    "dotenv": "^16.0.0",
    "esbuild": "^0.25.9",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "highlight.js": "11.11.1",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@assistant-ui/react": "0.15.31",
    "@assistant-ui/react-markdown": "0.14.24",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "linkedom": "0.18.12",
    "nodemon": "^3.1.4",
    "playwright": "1.58.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
