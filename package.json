{
  "name": "torin-x-web",
  "version": "2.12.2",
  "description": "Componentized task client and remote execution engine",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:client": "node server.js",
    "start:engine": "node apps/engine/server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "build:markdown": "esbuild scripts/markdown-view-entry.js --bundle --minify --format=iife --global-name=MarkdownView --outfile=public/js/markdown-view.js",
    "build:monaco": "esbuild scripts/monaco-entry.js --bundle --minify --supported:template-literal=false --format=iife --global-name=MonacoBundle --loader:.ttf=file --asset-names=[name]-[hash] --outfile=public/vendor/monaco/monaco.js && esbuild node_modules/monaco-editor/esm/vs/editor/editor.worker.js --bundle --minify --format=iife --outfile=public/vendor/monaco/editor.worker.js && esbuild node_modules/monaco-editor/esm/vs/languages/features/json/json.worker.js --bundle --minify --supported:template-literal=false --format=iife --outfile=public/vendor/monaco/json.worker.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.0.0",
    "esbuild": "^0.25.9",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "highlight.js": "11.11.1",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "linkedom": "0.18.12",
    "nodemon": "^3.1.4",
    "playwright": "1.58.2"
  }
}
