{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TA_HOOK_URL\" ] && curl -s -m 1 -o /dev/null -X POST -H \"X-TA-Token: $TA_HOOK_TOKEN\" \"$TA_HOOK_URL&event=start\" || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TA_HOOK_URL\" ] && curl -s -m 1 -o /dev/null -X POST -H \"X-TA-Token: $TA_HOOK_TOKEN\" \"$TA_HOOK_URL&event=stop\" || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TA_HOOK_URL\" ] && curl -s -m 1 -o /dev/null -X POST -H \"X-TA-Token: $TA_HOOK_TOKEN\" \"$TA_HOOK_URL&event=attention\" || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TA_HOOK_URL\" ] && curl -s -m 1 -o /dev/null -X POST -H \"X-TA-Token: $TA_HOOK_TOKEN\" \"$TA_HOOK_URL&event=end\" || true"
          }
        ]
      }
    ]
  }
}
